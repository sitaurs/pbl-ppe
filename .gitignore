# ╔══════════════════════════════════════════════════════════╗
# ║  SafeGuard APD — .gitignore                              ║
# ╚══════════════════════════════════════════════════════════╝

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
ENV/

# ── Secrets & environment ─────────────────────────────────────
.env
*.env.local
*.env.bak
*.env.env*

# ── Node.js ───────────────────────────────────────────────────
node_modules/
web-dashboard/.next/
web-dashboard/out/

# ── Database (SQLite local state — backup via TUI bundle) ─────
web-dashboard/data/*.db
web-dashboard/data/*.db-wal
web-dashboard/data/*.db-shm
web-dashboard/data/.migrated
web-dashboard/data/backup/

# ── YOLO / Ultralytics ────────────────────────────────────────
.ultralytics/
runs/
tmp_violation*.jpg

# Model weights (besar, regenerate via `python training/2_train_ppe.py`
# atau download dari rilis). Pengecualian: README di models/.
*.pt
*.onnx
*.engine
!models/README.md

# ── Datasets (besar, di-download via `python training/1_download_dataset.py`) ─
CHV-YOLOv8/train/
CHV-YOLOv8/valid/
CHV-YOLOv8/test/
other/datasets/*/train/
other/datasets/*/valid/
other/datasets/*/test/

# ── Audio source files (di-upload ke VPS, bukan source code) ──
other/sound/*.mp3
other/sound/*.mpeg
other/sound/*.txt
# Pengecualian: audio kecil yang di-flash ke SPIFFS ESP32 (bagian deploy).
!alarm_apd/data/*.mp3

# ── ESP32 PlatformIO build artifacts ──────────────────────────
alarm_apd/.pio/

# ── Cloudflare credentials (token-specific, per-machine) ──────
web-dashboard/cloudflared/*-credentials.json
*.before-import-*.bak

# ── Logs ──────────────────────────────────────────────────────
*.log

# ── IDE / Editor ──────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Temporary / scratch ───────────────────────────────────────
*.tmp
*.bak
*.orig
__sanity_pp.ts

# ── Bundle exports (config_bundle.py output) ──────────────────
safeguard-bundle-*.zip
