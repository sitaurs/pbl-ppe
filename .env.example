# ============================================================
# SafeGuard APD — Backend Configuration (Python)
# Copy this file to `.env` and fill in real values.
# Some variables MUST match `web-dashboard/.env.local` (lihat catatan).
# ============================================================

# ============================================================
# Database (SQLite, relative to project root)
# ============================================================
DATABASE_URL="file:./web-dashboard/data/safeguard.db"

# ============================================================
# Auth (must match web-dashboard/.env.local)
# ============================================================
JWT_SECRET=replace_with_random_64_hex_chars
NEXTAUTH_URL=http://localhost:3000

# Service token — HARUS sama dengan APD_SERVICE_TOKEN di web-dashboard/.env.local
APD_SERVICE_TOKEN=replace_with_64_hex_chars
APD_ENCRYPTION_KEY=replace_with_base64_32bytes

# ============================================================
# YOLO model
# ============================================================
YOLO_MODEL_PATH=yolov8n.pt

# Endpoint Next.js (untuk forwarding telemetry)
NODE_DETECTION_URL=http://localhost:3000

# ============================================================
# MQTT Broker (HiveMQ Cloud — TLS)
# ============================================================
MQTT_HOSTNAME=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password

# Topik MQTT
MQTT_TOPIC_PERSON=Person
MQTT_TOPIC_VIOLATION=APD_Violation
MQTT_TOPIC_FRAME=VideoFrame

# ============================================================
# AES-128-CBC Encryption
# Generate kunci kuat dengan:
#   python -c "import secrets; print(secrets.token_hex(16))"
# Output 32 hex chars = 16 bytes. IV di-randomize per pesan dan
# ditempel di awal ciphertext, jadi AES_IV TIDAK perlu di .env.
# ============================================================
AES_KEY=replace_with_32_hex_chars

# ============================================================
# WhatsApp API (GoWA Server) — opsional
# ============================================================
WA_API_URL=http://your-server-ip:3000
WA_API_USER=admin
WA_API_PASS=your_wa_password
WA_DEVICE_ID=pbl-alarm

# ============================================================
# Camera & Detection
# ============================================================
CONFIDENCE_THRESHOLD=0.65
PERSON_CONFIDENCE_THRESHOLD=0.60
COOLDOWN_SECONDS=2
WA_COOLDOWN_SECONDS=120

# ============================================================
# WebSocket Server
# ============================================================
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765

# ============================================================
# Dashboard
# ============================================================
DASHBOARD_API_URL=http://localhost:3000

# ============================================================
# GPU
# ============================================================
GPU_DEVICE_INDEX=0

# ============================================================
# Roboflow (hanya untuk download dataset)
# ============================================================
ROBOFLOW_API_KEY=your_roboflow_api_key
